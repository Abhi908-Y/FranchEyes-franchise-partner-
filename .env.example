# Set ONE of these keys. If both are set, OpenRouter is used.
# OpenRouter: get a key at https://openrouter.ai/keys and set a credit limit.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.7-flash
# Google AI Studio: get a key at https://aistudio.google.com/apikey and set a spending cap.
GEMINI_API_KEY=
# Optional: change the model if this one is retired.
GEMINI_MODEL=gemini-2.5-flash
